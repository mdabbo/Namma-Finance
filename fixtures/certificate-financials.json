  "status": [
    {
      "name": "draft never promoted by full collection",
      "current": "DRAFT",
      "netPayableMinor": 10000,
      "allocatedMinor": 10000,
      "expected": "DRAFT",
      "baseMinor": 10000
    },
    {
      "name": "draft with no collection",
      "current": "DRAFT",
      "netPayableMinor": 10000,
      "allocatedMinor": 0,
      "expected": "DRAFT",
      "baseMinor": 10000
    },
    {
      "name": "collection does not bypass approval",
      "current": "SUBMITTED",
      "netPayableMinor": 10000,
      "allocatedMinor": 10000,
      "expected": "SUBMITTED",
      "baseMinor": 10000
    },
    {
      "name": "over-collection does not bypass approval",
