  "rounding": {
    "_comment": "mulDivRound / mul_div_round_i64: rounded amount x numerator / denominator, HALF AWAY FROM ZERO. Negative cases exist because the two engines silently disagreed on them (Rust truncated toward zero, landing one minor unit high); nothing reaches them today, and this fixture is what keeps it that way.",
    "cases": [
      {
        "name": "positive half rounds away from zero",
        "amount": 5,
        "numerator": 1,
        "denominator": 2,
        "expected": 3
      },
      {
        "name": "positive third truncates down",
        "amount": 100,
        "numerator": 1,
        "denominator": 3,
        "expected": 33
      },
      {
        "name": "positive two-thirds rounds up",
        "amount": 200,
        "numerator": 1,
        "denominator": 3,
        "expected": 67
      },
      {
        "name": "negative half rounds away from zero",
        "amount": -5,
        "numerator": 1,
        "denominator": 2,
        "expected": -3
      },
      {
        "name": "negative third rounds away from zero",
        "amount": -100,
        "numerator": 1,
        "denominator": 3,
        "expected": -33
      },
      {
        "name": "negative exact half of one unit",
        "amount": -1,
        "numerator": 1,
        "denominator": 2,
        "expected": -1
      },
      {
        "name": "negative VAT line stays symmetric with its positive twin",
        "amount": -10000,
        "numerator": 1400,
        "denominator": 10000,
        "expected": -1400
      },
      {
        "name": "positive VAT line",
        "amount": 10000,
        "numerator": 1400,
        "denominator": 10000,
        "expected": 1400
      },
      {
        "name": "zero is unsigned",
        "amount": 0,
        "numerator": 1400,
        "denominator": 10000,
        "expected": 0
      },
      {
        "name": "exact division needs no rounding",
        "amount": -400,
        "numerator": 1,
        "denominator": 4,
        "expected": -100
      }
    ]
  }
